{
  "name": "cardgame",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && npm run build:cli",
    "build:cli": "vite build --config vite.cli.config.ts",
    "cli": "npm run build:cli --silent && node dist-cli/cardgame-cli.mjs",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:bench": "vitest bench --run --reporter=default src/test/ai-perf.bench.ts",
    "generate:card-art": "node scripts/generate-card-art.mjs",
    "generate:anime-card-art": "node scripts/generate-anime-card-art.mjs",
    "generate:board-backgrounds": "node scripts/generate-board-backgrounds.mjs",
    "ai:tournament": "vitest run --config vitest.tools.config.ts ai-tournament",
    "ai:tune": "vitest run --config vitest.tools.config.ts ai-tune"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "three": "^0.187.0"
  }
}
